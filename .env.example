# Inject real values through your environment or secret facility. Never commit them.
PUBLIC_ORIGIN=https://dashboard.example.com
DASHBOARD_CONFIG=/etc/dashboard/catalog.yaml
OIDC_ISSUER=https://auth.example.com/application/o/dashboard/
OIDC_CLIENT_ID=dashboard
# OIDC_CLIENT_SECRET and SESSION_SECRET must be supplied separately.
# SESSION_SECRET requires at least 32 random characters.
HOST=0.0.0.0
PORT=3000
DASHBOARD_DATA_DIR=/data
# Optional OTLP/HTTP traces. No request URLs, bodies, tokens or identities are emitted.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4318
